---
// Sticky top nav for the standalone marketing pages.
// Marks the active link from the current URL so callers don't pass a prop.
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
---
<nav class="nav">
  <a href="/" class="nav-wordmark">Comic Draft</a>
  <div class="nav-links">
    <a href="/guides/library">Guide</a>
    <a href="/contact" aria-current={path === '/contact' ? 'page' : undefined}>Contact</a>
  </div>
</nav>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-3) var(--space-8);
    background: var(--surface-app);
    border-bottom: 1px solid var(--border);
  }
  .nav-wordmark {
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    color: var(--text-primary);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    text-decoration: none;
  }
  .nav-links {
    display: flex;
    gap: var(--space-6);
  }
  .nav-links a {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .nav-links a:hover { color: var(--accent-text); }
  .nav-links a[aria-current='page'] { color: var(--text-primary); }

  @media (max-width: 600px) {
    .nav { padding: var(--space-3) var(--space-4); }
  }
</style>
