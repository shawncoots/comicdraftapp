---
// Google Analytics (gtag.js). Rendered only in production builds so local
// dev traffic doesn't pollute the reports.
const MEASUREMENT_ID = 'G-T2G23KXNV7';
---
{import.meta.env.PROD && (
  <>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${MEASUREMENT_ID}`}></script>
    <script is:inline define:vars={{ MEASUREMENT_ID }}>
      window.dataLayer = window.dataLayer || [];
      // define:vars wraps this script in an IIFE, so expose gtag globally.
      window.gtag = function(){dataLayer.push(arguments);};
      gtag('js', new Date());
      gtag('config', MEASUREMENT_ID);
    </script>
  </>
)}
