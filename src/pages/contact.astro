---
import '../styles/tokens.css';
import '../styles/site.css';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';

const CONTACT_EMAIL = 'shawn@anti-villain.com';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Comic Draft support — quick answers on getting started, sync, and export, plus a form for questions, bug reports, and feature requests." />
  <title>Comic Draft — Contact &amp; Support</title>
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
</head>
<body>

  <SiteNav />

  <section class="page-head">
    <p class="eyebrow">Support</p>
    <h1 class="headline">Contact &amp; Support</h1>
    <p class="tagline">
      Questions, bug reports, feature requests — all welcome. Fill this in and
      it will open a pre-written draft in your mail app, ready to send. For the
      things people ask most, see <a href="#quick-answers">quick answers</a> below.
    </p>
  </section>

  <section class="form-wrap">
    <form class="contact-form" id="contact-form" novalidate>
      <div class="field">
        <label for="name">Name</label>
        <input type="text" id="name" name="name" autocomplete="name" required />
      </div>

      <div class="field">
        <label for="email">Your email</label>
        <input type="email" id="email" name="email" autocomplete="email" required />
        <p class="hint">So we can write back.</p>
      </div>

      <div class="field">
        <label for="topic">Topic</label>
        <select id="topic" name="topic">
          <option value="General question">General question</option>
          <option value="Bug report">Bug report</option>
          <option value="Feature request">Feature request</option>
          <option value="Something else">Something else</option>
        </select>
      </div>

      <div class="field">
        <label for="message">Message</label>
        <textarea id="message" name="message" rows="8" maxlength="1500" required></textarea>
        <p class="hint"><span id="count">0</span> / 1500 characters</p>
      </div>

      <button type="submit" class="btn btn-primary">Compose email</button>

      <p class="status" id="status" role="status" aria-live="polite"></p>

      <p class="fallback">
        Mail app didn't open? Write to us directly at
        <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
      </p>
    </form>
  </section>

  <section class="answers-wrap" id="quick-answers">
    <div class="answers">
      <h2 class="answers-title">Quick answers</h2>

      <div class="answer">
        <h3>Getting started</h3>
        <p>
          Create a Series, add an Arc or Issue, and start typing — formatting
          happens as you write, with no markup to memorize.
          <a href="/guides/writing-a-script">Writing a script →</a>
        </p>
      </div>

      <div class="answer">
        <h3>Characters</h3>
        <p>
          Build a cast at the Series or Arc level and those characters appear in
          every issue beneath them.
          <a href="/guides/characters">Characters &amp; cast →</a>
        </p>
      </div>

      <div class="answer">
        <h3>Export</h3>
        <p>
          Finished scripts export to PDF, DOCX, or plain text from the export
          button.
          <a href="/guides/preview-export">Preview &amp; export →</a>
        </p>
      </div>

      <div class="answer">
        <h3>Sync</h3>
        <p>
          Your scripts and library sync automatically across Mac and iPad
          through your iCloud account. Make sure both devices are signed into
          the same iCloud account with iCloud Drive enabled.
          <a href="/guides/cross-platform">Cross-platform notes →</a>
        </p>
      </div>

      <p class="answers-foot">
        Still stuck? The <a href="/guides/library">full user guide</a> covers
        everything, or write to us using the form above.
      </p>
    </div>
  </section>

  <SiteFooter />

</body>
</html>

<script define:vars={{ CONTACT_EMAIL }}>
  const form = document.getElementById('contact-form');
  const status = document.getElementById('status');
  const message = document.getElementById('message');
  const count = document.getElementById('count');

  message.addEventListener('input', () => {
    count.textContent = String(message.value.length);
  });

  form.addEventListener('submit', (event) => {
    event.preventDefault();

    // Use native constraint validation, but surface it ourselves so the
    // form still reports errors with novalidate set.
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    const name = document.getElementById('name').value.trim();
    const email = document.getElementById('email').value.trim();
    const topic = document.getElementById('topic').value;
    const body = `${message.value.trim()}\n\n—\nFrom: ${name} <${email}>`;

    const href =
      `mailto:${CONTACT_EMAIL}` +
      `?subject=${encodeURIComponent(`[Comic Draft] ${topic}`)}` +
      `&body=${encodeURIComponent(body)}`;

    // Browsers silently drop very long mailto: URLs, so bail out loudly
    // instead of opening a draft with a truncated message.
    if (href.length > 1900) {
      status.textContent =
        `That message is too long to hand off to your mail app. Please shorten it, or email ${CONTACT_EMAIL} directly.`;
      status.classList.add('is-error');
      return;
    }

    status.classList.remove('is-error');
    status.textContent = 'Opening a draft in your mail app — it is not sent until you hit send there.';
    window.location.href = href;
  });
</script>

<style>
  /* ── Page head ── */
  .page-head {
    max-width: 680px;
    margin: 0 auto;
    padding: var(--space-16) var(--space-8) var(--space-8);
    text-align: center;
  }
  .eyebrow {
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: var(--accent-text);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    margin-bottom: var(--space-4);
  }
  .headline {
    font-size: var(--text-3xl);
    font-weight: var(--weight-bold);
    color: var(--text-primary);
    line-height: var(--leading-tight);
    margin-bottom: var(--space-6);
    letter-spacing: var(--tracking-tight);
  }
  .tagline {
    font-size: var(--text-md);
    color: var(--text-secondary);
    line-height: var(--leading-loose);
  }
  .tagline a { color: var(--accent-text); }

  /* ── Form ── */
  .form-wrap {
    padding: 0 var(--space-8) var(--space-16);
  }
  .contact-form {
    max-width: 560px;
    margin: 0 auto;
    background: var(--surface-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    padding: var(--space-8);
  }
  .field {
    margin-bottom: var(--space-6);
  }
  .field label {
    display: block;
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: var(--text-primary);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    margin-bottom: var(--space-2);
  }
  .field input,
  .field select,
  .field textarea {
    width: 100%;
    box-sizing: border-box;
    font-family: var(--font-mono);
    font-size: var(--text-base);
    color: var(--text-primary);
    background: var(--surface-editor);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: var(--space-3);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .field textarea {
    resize: vertical;
    line-height: var(--leading-loose);
  }
  .field input:focus-visible,
  .field select:focus-visible,
  .field textarea:focus-visible {
    outline: none;
    border-color: var(--border-focus);
    box-shadow: 0 0 0 3px var(--accent-subtle);
  }
  .field input:invalid:not(:placeholder-shown) {
    border-color: var(--destructive);
  }
  .hint {
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin-top: var(--space-2);
  }
  .status {
    font-size: var(--text-xs);
    color: var(--text-muted);
    line-height: var(--leading-loose);
    margin-top: var(--space-4);
  }
  .status.is-error { color: var(--destructive); }
  .status:empty { display: none; }
  .fallback {
    font-size: var(--text-xs);
    color: var(--text-muted);
    line-height: var(--leading-loose);
    margin-top: var(--space-6);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border);
  }
  .fallback a { color: var(--accent-text); }

  /* ── Quick answers ── */
  .answers-wrap {
    padding: 0 var(--space-8) var(--space-16);
  }
  .answers {
    max-width: 560px;
    margin: 0 auto;
  }
  .answers-title {
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: var(--text-muted);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    text-align: center;
    margin-bottom: var(--space-6);
  }
  .answer {
    padding: var(--space-5) 0;
    border-top: 1px solid var(--border);
  }
  .answer h3 {
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    color: var(--text-primary);
    margin-bottom: var(--space-2);
  }
  .answer p {
    font-size: var(--text-base);
    color: var(--text-secondary);
    line-height: var(--leading-loose);
  }
  .answer a,
  .answers-foot a {
    color: var(--accent-text);
    white-space: nowrap;
  }
  .answers-foot {
    font-size: var(--text-xs);
    color: var(--text-muted);
    line-height: var(--leading-loose);
    text-align: center;
    margin-top: var(--space-6);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border);
  }

  /* ── Responsive ── */
  @media (max-width: 600px) {
    .page-head { padding: var(--space-10) var(--space-4) var(--space-6); }
    .headline { font-size: var(--text-2xl); }
    .form-wrap { padding: 0 var(--space-4) var(--space-10); }
    .contact-form { padding: var(--space-6); }
    .answers-wrap { padding: 0 var(--space-4) var(--space-10); }
  }
</style>
