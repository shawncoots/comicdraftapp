---
import { Image, Picture } from 'astro:assets';
import '../styles/tokens.css';
import '../styles/site.css';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SeoHead from '../components/SeoHead.astro';
import StructuredData from '../components/StructuredData.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import appIcon from '../assets/appicon.png';
import editorLibrary from '../assets/screenshots/editor-library.png';
import formatPreview from '../assets/screenshots/format-preview.png';
import outlineDark from '../assets/screenshots/outline-dark.png';
import exportOptions from '../assets/screenshots/export-options.png';

// Screenshots fill half of a 1200px grid on desktop and the full width
// below 860px, so offer widths up to the 1800px source.
const shotWidths = [600, 1200, 1800];
const shotSizes = '(max-width: 860px) 100vw, 584px';
---
<!doctype html>
<html lang="en">
<head>
  <SeoHead
    title="ComicDraft — Comic Script Writing App for Mac & iPad"
    description="Write comic book scripts on Mac & iPad. ComicDraft formats pages, panels, dialog and SFX as you type, auto-numbers everything, and exports to PDF and Word."
    path="/"
  />
  <StructuredData />
  <GoogleAnalytics />
</head>
<body>

  <SiteNav />

  <section class="hero">
    <Image
      src={appIcon}
      alt="ComicDraft app icon"
      width={112}
      height={112}
      densities={[1, 2]}
      loading="eager"
      class="hero-icon"
    />
    <p class="hero-eyebrow">For Mac &amp; iPad</p>
    <h1 class="hero-headline">Write Comics.<br />Just Comics.</h1>
    <h2 class="hero-subhead">The comic script writing app for Mac and iPad.</h2>
    <p class="hero-tagline">
      ComicDraft is a focused script editor built specifically for comic authors. Never battle templates designed for other mediums again.
    </p>
    <div class="hero-actions">
      <a href="/guides/library" class="btn btn-primary">Learn how the app works</a>
      <a href="https://apps.apple.com/app/id6781109986" class="btn btn-ghost">Download on the App Store</a>
    </div>
  </section>

  <section class="features">
    <div class="features-grid">
      <div class="feature-card">
        <div class="feature-label">Structure</div>
        <h3 class="feature-title">Elements as you type</h3>
        <p class="feature-body">
          PAGE, PANEL, CHARACTER, DIALOG, CAPTION, SFX — each element is
          recognized and formatted on the fly. No toolbars. No menus. Just writing. Keyboard shortcuts also format exactly what you need.
        </p>
      </div>
      <div class="feature-card">
        <div class="feature-label">Numbering</div>
        <h3 class="feature-title">Auto-numbered, always</h3>
        <p class="feature-body">
          Pages and panels renumber themselves as you add, remove, or reorder
          them. Your script stays consistent without any manual work. Never manually type a page or panel number again.
        </p>
      </div>
      <div class="feature-card">
        <div class="feature-label">Splash pages</div>
        <h3 class="feature-title">Spreads in one keystroke</h3>
        <p class="feature-body">
          Press ⌘8, or start two PAGEs in a row, and they collapse into a single
          PAGE-ONE &amp; PAGE-TWO (SPLASH) heading. Numbering picks up correctly on
          the next page.
        </p>
      </div>
      <div class="feature-card">
        <div class="feature-label">Library</div>
        <h3 class="feature-title">Series, arcs, and issues</h3>
        <p class="feature-body">
          Organize long-running titles into series, story arcs, and issues, or
          keep standalone graphic novels on their own. Recurring characters set
          at the series level appear in every issue's cast.
        </p>
      </div>
      <div class="feature-card">
        <div class="feature-label">Outline</div>
        <h3 class="feature-title">Beats beside the script</h3>
        <p class="feature-body">
          A lightweight three-act beat tracker lives in the inspector. Give each
          beat a description, mark it Idea, Drafting, or Done, and drag to
          reorder as the story changes.
        </p>
      </div>
      <div class="feature-card">
        <div class="feature-label">Preview &amp; export</div>
        <h3 class="feature-title">See the page, then send it</h3>
        <p class="feature-body">
          Format preview shows every page as it will export, with cover page,
          running headers, and page numbers. Export to PDF, Word, or plain text,
          ready for your artist, letterer, or publisher.
        </p>
      </div>
    </div>
  </section>

  <section class="why">
    <div class="why-inner">
      <p class="section-eyebrow">Built for comics</p>
      <h2 class="section-title">Why not Final Draft or Scrivener?</h2>
      <p class="section-intro">
        Final Draft is built for screenplays and Scrivener for novels. Both can
        be bent into a comic template, but underneath they still think in scenes
        and chapters. ComicDraft starts from pages and panels.
      </p>
      <div class="why-grid">
        <div class="why-point">
          <h3>Panel numbers aren't your job</h3>
          <p>
            Page and panel numbers are structure, not text you maintain. Cut a
            panel, move a page, add three more, and everything renumbers on the
            next keystroke.
          </p>
        </div>
        <div class="why-point">
          <h3>Splash pages are a real thing</h3>
          <p>
            Two PAGEs in a row collapse into one
            <code>PAGE-ONE &amp; PAGE-TWO (SPLASH)</code> heading, and the page
            count stays correct after it.
          </p>
        </div>
        <div class="why-point">
          <h3>Dialog your letterer can read</h3>
          <p>
            CHARACTER, DIALOG, CAPTION and SFX follow the conventions letterers
            expect, so every balloon, caption and sound effect is easy to find
            and place.
          </p>
        </div>
        <div class="why-point">
          <h3>Series, arcs and issues</h3>
          <p>
            A comic isn't one long document. The library holds series, story
            arcs, issues and standalone graphic novels, with the cast shared
            from the series down.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="screenshots">
    <div class="screenshots-grid">
      <figure class="screenshot-figure">
        <Picture
          src={editorLibrary}
          alt="ComicDraft editor with the series library on the left, a formatted comic script in the centre, and the issue details inspector on the right"
          class="screenshot-img"
          widths={shotWidths}
          sizes={shotSizes}
          formats={['avif']}
          fallbackFormat="webp"
          loading="lazy"
        />
        <figcaption>Series, arcs, and issues on the left. Your script in the middle. Issue details on the right.</figcaption>
      </figure>
      <figure class="screenshot-figure">
        <Picture
          src={formatPreview}
          alt="ComicDraft format preview showing a script rendered in Courier with font, layout, and dialog controls in the side panel"
          class="screenshot-img"
          widths={shotWidths}
          sizes={shotSizes}
          formats={['avif']}
          fallbackFormat="webp"
          loading="lazy"
        />
        <figcaption>Format preview — switch font, layout, and dialog casing and watch the page update live.</figcaption>
      </figure>
      <figure class="screenshot-figure">
        <Picture
          src={outlineDark}
          alt="ComicDraft in dark mode with the outline inspector open, showing four story beats each marked with a draft status"
          class="screenshot-img"
          widths={shotWidths}
          sizes={shotSizes}
          formats={['avif']}
          fallbackFormat="webp"
          loading="lazy"
        />
        <figcaption>Track your beats in the outline inspector. Dark mode included.</figcaption>
      </figure>
      <figure class="screenshot-figure">
        <Picture
          src={exportOptions}
          alt="ComicDraft export dialog offering PDF, Word, and plain text formats alongside font, layout, and header options"
          class="screenshot-img"
          widths={shotWidths}
          sizes={shotSizes}
          formats={['avif']}
          fallbackFormat="webp"
          loading="lazy"
        />
        <figcaption>Export to PDF, Word, or plain text — with the formatting your editor expects.</figcaption>
      </figure>
    </div>
  </section>

  <SiteFooter />

</body>
</html>

<style>
  /* ── Hero ── */
  .hero {
    max-width: 680px;
    margin: 0 auto;
    padding: var(--space-16) var(--space-8);
    text-align: center;
  }
  /* The source icon is a full-bleed square, so the app-icon corner
     rounding has to come from CSS rather than the asset itself. */
  .hero-icon {
    display: block;
    width: 112px;
    height: 112px;
    margin: 0 auto var(--space-6);
    border-radius: 22.5%;
    box-shadow: var(--shadow-lg);
  }
  .hero-eyebrow {
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: var(--accent-text);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    margin-bottom: var(--space-4);
  }
  .hero-headline {
    font-size: var(--text-3xl);
    font-weight: var(--weight-bold);
    color: var(--text-primary);
    line-height: var(--leading-tight);
    margin-bottom: var(--space-6);
    letter-spacing: var(--tracking-tight);
  }
  .hero-subhead {
    font-size: var(--text-md);
    font-weight: var(--weight-medium);
    color: var(--text-primary);
    line-height: var(--leading-normal);
    margin-bottom: var(--space-4);
  }
  .hero-tagline {
    font-size: var(--text-md);
    color: var(--text-secondary);
    line-height: var(--leading-loose);
    margin-bottom: var(--space-8);
  }
  .hero-actions {
    display: flex;
    gap: var(--space-3);
    justify-content: center;
    flex-wrap: wrap;
  }

  /* ── Features ── */
  .features {
    background: var(--surface-sidebar);
    padding: var(--space-16) var(--space-8);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-5);
    max-width: 960px;
    margin: 0 auto;
  }
  .feature-card {
    background: var(--surface-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    box-shadow: var(--shadow-sm);
  }
  .feature-label {
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: var(--accent-text);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    margin-bottom: var(--space-2);
  }
  .feature-title {
    font-size: var(--text-base);
    font-weight: var(--weight-bold);
    color: var(--text-primary);
    margin-bottom: var(--space-2);
  }
  .feature-body {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--leading-loose);
  }

  /* ── Shared section headings ── */
  .section-eyebrow {
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: var(--accent-text);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    text-align: center;
    margin-bottom: var(--space-3);
  }
  .section-title {
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
    color: var(--text-primary);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    text-align: center;
    margin-bottom: var(--space-4);
  }
  .section-intro {
    max-width: 640px;
    margin: 0 auto var(--space-10);
    font-size: var(--text-base);
    color: var(--text-secondary);
    line-height: var(--leading-loose);
    text-align: center;
  }

  /* ── Why ComicDraft ── */
  .why {
    padding: var(--space-16) var(--space-8);
    border-bottom: 1px solid var(--border);
  }
  .why-inner {
    max-width: 960px;
    margin: 0 auto;
  }
  .why-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-8) var(--space-10);
  }
  .why-point {
    border-top: 2px solid var(--accent);
    padding-top: var(--space-4);
  }
  .why-point h3 {
    font-size: var(--text-base);
    font-weight: var(--weight-bold);
    color: var(--text-primary);
    margin-bottom: var(--space-2);
  }
  .why-point p {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--leading-loose);
  }
  .why-point code {
    font-family: var(--font-script);
    font-size: var(--text-sm);
    color: var(--text-primary);
    white-space: nowrap;
  }

  /* ── Screenshots ── */
  .screenshots {
    padding: var(--space-16) var(--space-8);
    background: var(--surface-app);
  }
  .screenshots-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-8);
    max-width: 1200px;
    margin: 0 auto;
  }
  .screenshot-figure { margin: 0; }
  .screenshot-img {
    width: 100%;
    height: auto;
    aspect-ratio: 1800 / 1170;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-lg);
    display: block;
  }
  .screenshot-figure figcaption {
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin-top: var(--space-2);
    text-align: center;
    letter-spacing: var(--tracking-wide);
  }

  /* ── Responsive ── */
  @media (max-width: 860px) {
    .screenshots-grid { grid-template-columns: 1fr; }
    .why-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .hero { padding: var(--space-10) var(--space-4); }
    .hero-icon {
      width: 88px;
      height: 88px;
      margin-bottom: var(--space-5);
    }
    .hero-headline { font-size: var(--text-2xl); }
    .features { padding: var(--space-10) var(--space-4); }
    .why { padding: var(--space-10) var(--space-4); }
    .section-title { font-size: var(--text-xl); }
    .screenshots { padding: var(--space-10) var(--space-4); }
  }
</style>
