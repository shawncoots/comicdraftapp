---
import '../styles/tokens.css';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Comic Draft — the focused comic script writing app for macOS and iPadOS." />
  <title>Comic Draft — Write comics. Just comics.</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body>

  <nav class="nav">
    <span class="nav-wordmark">Comic Draft</span>
    <div class="nav-links">
      <a href="/guides/library">Docs</a>
      <a href="/contact">Contact</a>
    </div>
  </nav>

  <section class="hero">
    <p class="hero-eyebrow">For Mac &amp; iPad</p>
    <h1 class="hero-headline">Write Comics.<br />Just Comics.</h1>
    <p class="hero-tagline">
      Comic Draft is a focused script editor built specifically for comic authors. Never battle templates designed for other mediums again.
    </p>
    <div class="hero-actions">
      <a href="/guides/library" class="btn btn-primary">Learn how the app works</a>
      <a href="#" class="btn btn-ghost">Download on the App Store</a>
    </div>
  </section>

  <section class="features">
    <div class="features-grid">
      <div class="feature-card">
        <div class="feature-label">Structure</div>
        <h3 class="feature-title">Elements as you type</h3>
        <p class="feature-body">
          PAGE, PANEL, CHARACTER, DIALOG, CAPTION, SFX — each element is
          recognized and formatted on the fly. No toolbars. No menus. Just writing. Keyboard shortcuts also format exactly what you need.
        </p>
      </div>
      <div class="feature-card">
        <div class="feature-label">Numbering</div>
        <h3 class="feature-title">Auto-numbered, always</h3>
        <p class="feature-body">
          Pages and panels renumber themselves as you add, remove, or reorder
          them. Your script stays consistent without any manual work. Never manually type a page or panel number again.
        </p>
      </div>
      <div class="feature-card">
        <div class="feature-label">Export</div>
        <h3 class="feature-title">One tap to share</h3>
        <p class="feature-body">
          Export your finished script to PDF, DOCX, or FDX with a single tap.
          Ready to send to your artist, letterer, or publisher.
        </p>
      </div>
    </div>
  </section>

  <section class="screenshots">
    <div class="screenshots-grid">
      <figure class="screenshot-figure">
        <img
          src="/screenshots/editor-library.png"
          alt="Comic Draft editor with the series library on the left, a formatted comic script in the centre, and the issue details inspector on the right"
          class="screenshot-img"
          width="1800"
          height="1170"
          loading="lazy"
        />
        <figcaption>Series, arcs, and issues on the left. Your script in the middle. Issue details on the right.</figcaption>
      </figure>
      <figure class="screenshot-figure">
        <img
          src="/screenshots/format-preview.png"
          alt="Comic Draft format preview showing a script rendered in Courier with font, layout, and dialog controls in the side panel"
          class="screenshot-img"
          width="1800"
          height="1170"
          loading="lazy"
        />
        <figcaption>Format preview — switch font, layout, and dialog casing and watch the page update live.</figcaption>
      </figure>
      <figure class="screenshot-figure">
        <img
          src="/screenshots/outline-dark.png"
          alt="Comic Draft in dark mode with the outline inspector open, showing four story beats each marked with a draft status"
          class="screenshot-img"
          width="1800"
          height="1170"
          loading="lazy"
        />
        <figcaption>Track your beats in the outline inspector. Dark mode included.</figcaption>
      </figure>
      <figure class="screenshot-figure">
        <img
          src="/screenshots/export-options.png"
          alt="Comic Draft export dialog offering PDF, Word, and plain text formats alongside font, layout, and header options"
          class="screenshot-img"
          width="1800"
          height="1170"
          loading="lazy"
        />
        <figcaption>Export to PDF, Word, or plain text — with the formatting your editor expects.</figcaption>
      </figure>
    </div>
  </section>

  <footer class="footer">
    <span class="footer-copy">&copy; 2026 <a href="https://anti-villain.com">ANTI-VILLAIN</a></span>
    <nav class="footer-links">
      <a href="/guides/library">Guide</a>
      <a href="/contact">Contact</a>
    </nav>
  </footer>

</body>
</html>

<style>
  /* ── Reset ── */
  html, body {
    margin: 0;
    padding: 0;
    background: var(--surface-app);
    color: var(--text-primary);
    font-family: var(--font-mono);
    -webkit-font-smoothing: antialiased;
  }
  h1, h2, h3, p, figure { margin: 0; }
  a { color: inherit; }

  /* ── Nav ── */
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-3) var(--space-8);
    background: var(--surface-app);
    border-bottom: 1px solid var(--border);
  }
  .nav-wordmark {
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    color: var(--text-primary);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }
  .nav-links {
    display: flex;
    gap: var(--space-6);
  }
  .nav-links a {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .nav-links a:hover { color: var(--accent-text); }

  /* ── Hero ── */
  .hero {
    max-width: 680px;
    margin: 0 auto;
    padding: var(--space-16) var(--space-8);
    text-align: center;
  }
  .hero-eyebrow {
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: var(--accent-text);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    margin-bottom: var(--space-4);
  }
  .hero-headline {
    font-size: var(--text-3xl);
    font-weight: var(--weight-bold);
    color: var(--text-primary);
    line-height: var(--leading-tight);
    margin-bottom: var(--space-6);
    letter-spacing: var(--tracking-tight);
  }
  .hero-tagline {
    font-size: var(--text-md);
    color: var(--text-secondary);
    line-height: var(--leading-loose);
    margin-bottom: var(--space-8);
  }
  .hero-actions {
    display: flex;
    gap: var(--space-3);
    justify-content: center;
    flex-wrap: wrap;
  }

  /* ── Buttons ── */
  .btn {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    padding: var(--space-3) var(--space-5);
    border-radius: var(--radius-md);
    text-decoration: none;
    border: 1px solid transparent;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  .btn-primary {
    background: var(--accent);
    color: var(--text-on-accent);
  }
  .btn-primary:hover { background: var(--accent-hover); }
  .btn-ghost {
    background: transparent;
    color: var(--text-secondary);
    border-color: var(--border);
  }
  .btn-ghost:hover {
    color: var(--text-primary);
    border-color: var(--text-secondary);
  }

  /* ── Features ── */
  .features {
    background: var(--surface-sidebar);
    padding: var(--space-16) var(--space-8);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-5);
    max-width: 960px;
    margin: 0 auto;
  }
  .feature-card {
    background: var(--surface-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    box-shadow: var(--shadow-sm);
  }
  .feature-label {
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: var(--accent-text);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    margin-bottom: var(--space-2);
  }
  .feature-title {
    font-size: var(--text-base);
    font-weight: var(--weight-bold);
    color: var(--text-primary);
    margin-bottom: var(--space-2);
  }
  .feature-body {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--leading-loose);
  }

  /* ── Screenshots ── */
  .screenshots {
    padding: var(--space-16) var(--space-8);
    background: var(--surface-app);
  }
  .screenshots-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-8);
    max-width: 1200px;
    margin: 0 auto;
  }
  .screenshot-figure { margin: 0; }
  .screenshot-img {
    width: 100%;
    height: auto;
    aspect-ratio: 1800 / 1170;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-lg);
    display: block;
  }
  .screenshot-figure figcaption {
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin-top: var(--space-2);
    text-align: center;
    letter-spacing: var(--tracking-wide);
  }

  /* ── Footer ── */
  .footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-5) var(--space-8);
    border-top: 1px solid var(--border);
    background: var(--surface-sidebar);
  }
  .footer-copy {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }
  .footer-links {
    display: flex;
    gap: var(--space-6);
  }
  .footer-links a {
    font-size: var(--text-xs);
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .footer-links a:hover { color: var(--accent-text); }

  /* ── Responsive ── */
  @media (max-width: 860px) {
    .screenshots-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .nav { padding: var(--space-3) var(--space-4); }
    .hero { padding: var(--space-10) var(--space-4); }
    .hero-headline { font-size: var(--text-2xl); }
    .features { padding: var(--space-10) var(--space-4); }
    .screenshots { padding: var(--space-10) var(--space-4); }
    .footer { padding: var(--space-4); flex-direction: column; gap: var(--space-2); text-align: center; }
  }
</style>
